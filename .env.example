# Copy to .env and fill in for local development.

# Used by Prisma Client at runtime. Locally this is your plain Postgres
# connection; in production (Neon via Vercel) this is the pooled
# (PgBouncer) connection string — the one with "-pooler" in the hostname.
DATABASE_URL="postgresql://user:password@localhost:5432/negotiator"

# Used only by `prisma migrate deploy`/`migrate dev` (advisory locks need
# a direct, non-pooled connection). Locally this can be identical to
# DATABASE_URL; in production this is Neon's direct connection string
# (no "-pooler" in the hostname).
DIRECT_URL="postgresql://user:password@localhost:5432/negotiator"

# Base URL used to build magic-link URLs in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign the staff session cookie (any long random string).
# Real per-user email+password accounts (this replaced Phase 1's single
# shared INTERNAL_PASSWORD entirely). `pnpm prisma:seed` creates dev-only
# logins and prints them to the console: an admin@example.com Admin, a
# Negotiator per seeded name, and a Business login for each seeded
# business's primary contact — never used for anything but local dev.
SESSION_SECRET="change-me"

# Optional. If unset, outgoing email is logged (EmailLog + console) instead
# of sent — the app is fully testable without this.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="The Negotiator <onboarding@resend.dev>"
SUPPORT_EMAIL="support@example.com"

# Required for the Admin → Content media upload feature (page-content CMS).
# Create a Blob store in the Vercel dashboard (Storage tab → Create
# Database → Blob) and copy its token here for local dev, or run
# `vercel env pull .env.local` if the repo is linked. Without this,
# uploading an image/video in Admin → Content will fail — everything else
# in the app works fine without it.
BLOB_READ_WRITE_TOKEN=""
