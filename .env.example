# Copy to .env and fill in for local development.

DATABASE_URL="file:./dev.db"

# Base URL used to build magic-link URLs in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shared password gating everything under /internal (Phase 1 has no
# per-user internal auth — see CLAUDE.md / plan assumption 4).
INTERNAL_PASSWORD="change-me"
# Secret used to sign the internal session cookie (any long random string).
INTERNAL_SESSION_SECRET="change-me-too"

# Optional. If unset, outgoing email is logged (EmailLog + console) instead
# of sent — the app is fully testable without this.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="The Negotiator <onboarding@resend.dev>"
SUPPORT_EMAIL="support@example.com"
